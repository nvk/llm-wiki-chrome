{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmwiki.net/schemas/private/browser-executor/result-v1.schema.json",
  "title": "LLM Wiki bounded browser result",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "type", "job_id", "status", "public", "private"],
  "properties": {
    "protocol": {"const": "llm-wiki-browser-executor/v1"},
    "type": {"const": "result"},
    "job_id": {"type": "string", "pattern": "^[a-f0-9]{36}$"},
    "status": {"enum": ["ok", "error"]},
    "public": {
      "type": "object",
      "propertyNames": {
        "enum": ["status", "action_count", "mutation_started", "private_result_count"]
      }
    },
    "private": {"type": "object", "maxProperties": 32},
    "error": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"}
  }
}
