{
  "manifest_version": 3,
  "name": "LLM Wiki for Chrome",
  "description": "Gives local agents and targeted adapters bounded control of explicitly shared tabs.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "debugger",
    "downloads",
    "nativeMessaging",
    "notifications",
    "scripting",
    "sidePanel",
    "storage",
    "tabGroups"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "LLM Wiki for Chrome",
    "default_icon": {"128": "icon-128.png"}
  },
  "icons": {"128": "icon-128.png"},
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
