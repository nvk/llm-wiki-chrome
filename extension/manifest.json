{
  "manifest_version": 3,
  "name": "LLM Wiki Browser Executor",
  "description": "Gives local agents and private adapters bounded control of explicitly shared tabs.",
  "version": "0.0.1",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "LLM Wiki Browser Executor"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
